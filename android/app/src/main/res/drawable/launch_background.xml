<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch splash: deep Raga purple with the figure mark centered.
     Automatically replaced when the Flutter engine draws its first frame,
     at which point the animated Flutter splash takes over seamlessly. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item
        android:drawable="@drawable/splash_mark"
        android:gravity="center" />
</layer-list>
